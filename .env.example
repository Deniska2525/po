# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git (см. .gitignore).

# Строка подключения к БД (Postgres в проде, sqlite можно локально)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Секрет для подписи JWT-токенов. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# URL фронтенда для CORS
FRONTEND_URL=http://localhost:5173

# development | production
ENV=development

# Пароли демо-аккаунтов при первом заполнении пустой базы.
# В production демо-юзеры НЕ создаются, если не задано SEED_DEMO_USERS=true.
#SEED_DEMO_USERS=false
#SEED_ADMIN_PASSWORD=
#SEED_DEV_PASSWORD=
#SEED_USER_PASSWORD=

# Ключ для ИИ-поиска на главной странице (/ai-search). Работает с любым
# OpenAI-совместимым провайдером — рекомендуем бесплатные варианты без карты:
#   OpenRouter (по умолчанию, Gemma 4): https://openrouter.ai/keys
#   Groq (быстрый, без Gemma 4):        https://console.groq.com/keys
#   Gemini (тоже бесплатно):            https://aistudio.google.com/apikey
# Без ключа /ai-search вернёт понятную ошибку 503, остальной сайт продолжит работать.
AI_API_KEY=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

# base_url и модель провайдера. Дефолты в коде уже настроены на OpenRouter + Gemma 4,
# менять нужно только если переключаетесь на другого провайдера.
# OpenRouter + Gemma 4 (по умолчанию, бесплатный тариф ":free"):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemma-4-31b-it:free
# Groq (Gemma 4 там пока не хостится, только старая Gemma 2 9B):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# Gemini:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.0-flash
